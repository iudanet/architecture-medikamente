        <mxCell id="t1" value="&lt;b&gt;Медикаменте — C4 Context (to-be)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="34" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;Медикаменте&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#444444;strokeWidth=2;fontColor=#444444;fontSize=13;align=left;verticalAlign=bottom;spacingLeft=12;spacingTop=6;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="1500" height="1330" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;Прикладные системы&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1168BD;strokeWidth=2;fontColor=#1168BD;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="1060" height="660" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;Аналитический слой&lt;/b&gt; (только обезличенные данные)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#6A1B9A;strokeWidth=2;fontColor=#6A1B9A;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="720" y="1290" width="1060" height="250" as="geometry"/></mxCell>
        <mxCell id="p5" value='&lt;b style="font-size:13px"&gt;Пациент&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;' style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="40" width="200" height="160" as="geometry"/></mxCell>
        <mxCell id="p6" value='&lt;b style="font-size:13px"&gt;Сотрудник ресепшена&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;' style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="40" width="200" height="160" as="geometry"/></mxCell>
        <mxCell id="p7" value='&lt;b style="font-size:13px"&gt;Врач&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;' style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="40" width="180" height="160" as="geometry"/></mxCell>
        <mxCell id="p8" value='&lt;b style="font-size:13px"&gt;Кассир&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;' style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1830" y="40" width="180" height="160" as="geometry"/></mxCell>
        <mxCell id="p9" value='&lt;b style="font-size:13px"&gt;Бухгалтер / Склад&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;' style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="40" width="200" height="160" as="geometry"/></mxCell>
        <mxCell id="p10" value='&lt;b style="font-size:13px"&gt;Ответственный за обработку ПДн (DPO)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;' style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="220" height="190" as="geometry"/></mxCell>
        <mxCell id="p11" value='&lt;b style="font-size:13px"&gt;Бизнес-аналитик&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;' style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1520" y="1610" width="200" height="160" as="geometry"/></mxCell>
        <mxCell id="c12" value='&lt;b style="font-size:13px"&gt;IAM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Privacy by Design: Keycloak]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Федерация с AD, MFA, OIDC, RBAC/ABAC&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="290" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="c13" value='&lt;b style="font-size:13px"&gt;Каталог данных и политики&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Privacy by Design: Apache Atlas + Apache Ranger]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Классификация и теги, lineage; доступ и маскирование по тегам&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="450" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c14" value='&lt;b style="font-size:13px"&gt;Сервис согласий и запросов субъектов ПДн&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Privacy by Design]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Согласия, отзыв, прекращение обработки, удаление&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="610" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="c15" value='&lt;b style="font-size:13px"&gt;Аудит и мониторинг&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Privacy by Design: Elastic, SIEM/UEBA, VictoriaMetrics + Grafana]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Журнал доступа, нетипичные действия, алерты&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="770" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="c16" value='&lt;b style="font-size:13px"&gt;DLP&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Privacy by Design]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Контроль утечек: почта, рабочие станции&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="940" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="c17" value='&lt;b style="font-size:13px"&gt;KMS / Vault + HSM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Privacy by Design]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Ключи шифрования; сервис токенизации / псевдонимизации&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="1070" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="c18" value='&lt;b style="font-size:13px"&gt;Клиентский портал&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System, MVP]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Запись к врачу, личный кабинет&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#E07B00;strokeWidth=4;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="730" y="290" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="c19" value='&lt;b style="font-size:13px"&gt;Мобильное приложение&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System, финал]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Запись, push, подтверждение / отмена, свои документы&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="290" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="c20" value='&lt;b style="font-size:13px"&gt;Портал ресепшена&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System, MVP]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Записи пациентов, маскированные ПДн&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#E07B00;strokeWidth=4;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1310" y="290" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="c21" value='&lt;b style="font-size:13px"&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Privacy by Design]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Единая точка входа: проверка токена и владельца данных (owner = sub), фильтрация полей контракта по тегам&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="730" y="460" width="1030" height="90" as="geometry"/></mxCell>
        <mxCell id="c22" value='&lt;b style="font-size:13px"&gt;CRM / Регистратура&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System, MVP]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Пациенты (минимум ПДн), записи, договоры&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#E07B00;strokeWidth=4;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="760" y="630" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c23" value='&lt;b style="font-size:13px"&gt;МИС / ЭМК&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Медкарты, заключения, результаты анализов&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="760" y="800" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c24" value='&lt;b style="font-size:13px"&gt;Сервис уведомлений&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System, MVP]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;MVP: SMS / email-напоминание.&lt;br&gt;Финал: push, голосовой робот, подтверждение / отмена&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#E07B00;strokeWidth=4;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1470" y="630" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c25" value='&lt;b style="font-size:13px"&gt;Интеграционный шлюз лаборатории&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Обмен с лабораторией по sample_id&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1470" y="800" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c26" value='&lt;b style="font-size:13px"&gt;Платёжный шлюз&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Оплата, токенизация карт&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1470" y="960" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="c27" value='&lt;b style="font-size:13px"&gt;1С «Бухгалтерия» и «Торговля и склад»&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System, клиент-серверный режим]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Учёт, зарплата, ТМЦ&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D5D5;strokeColor=#666666;strokeWidth=2;fontColor=#222222;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1470" y="1100" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="c28" value='&lt;b style="font-size:13px"&gt;Apache NiFi&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Конвейер данных]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Загрузка, псевдонимизация&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=#4A148C;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="1340" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="d29" value='&lt;b style="font-size:13px"&gt;Озеро данных&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[MinIO / S3]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;raw → verified → golden&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=#4A148C;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1010" y="1340" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="d30" value='&lt;b style="font-size:13px"&gt;ClickHouse&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Витрины]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;golden&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=#4A148C;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1270" y="1340" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="c31" value='&lt;b style="font-size:13px"&gt;BI / ML-песочница&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Superset, Jupyter]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Отчёты, модели&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=#4A148C;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1530" y="1340" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="c32" value='&lt;b style="font-size:13px"&gt;Госуслуги (ЕСИА)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External System, финал]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Вход пациента&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="c33" value='&lt;b style="font-size:13px"&gt;SMS / голосовой провайдер&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External System]&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1880" y="640" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="c34" value='&lt;b style="font-size:13px"&gt;Лаборатория анализов&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External System]&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1880" y="810" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="c35" value='&lt;b style="font-size:13px"&gt;Эквайер / банк&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External System]&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1880" y="960" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="c36" value='&lt;b style="font-size:13px"&gt;ОФД&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External System]&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1880" y="1095" width="240" height="80" as="geometry"/></mxCell>
